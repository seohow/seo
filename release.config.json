{
  "releaseRoot": "releases",
  "versionPrefix": "v",
  "layout": {
    "setup": "setup",
    "category": "categories/<category>",
    "zipName": "<skill>.zip"
  },
  "platformCompatibility": {
    "descriptionMaxChars": 200
  },
  "githubRelease": {
    "assetGlobs": [
      "releases/<version>/README.md",
      "releases/<version>/manifest.json",
      "releases/<version>/checksums.txt",
      "releases/<version>/setup/*.zip",
      "releases/<version>/categories/**/*.zip",
      "releases/seo-toolkit.plugin"
    ]
  }
}
